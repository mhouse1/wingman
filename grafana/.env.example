# Design 018: copy to grafana/.env (untracked) and set each password.
#   cp grafana/.env.example grafana/.env
# The Postgres superuser: the ingest connects as it, inside the container.
POSTGRES_PASSWORD=change-me
# grafana_reader, the read-only role the dashboard queries with. Created on the
# first start of an empty volume; changing it later needs ALTER ROLE.
GRAFANA_DB_PASSWORD=change-me-too
# Grafana's admin login, for editing the dashboard (viewing needs no login).
GRAFANA_ADMIN_PASSWORD=change-me-three
