#!/usr/bin/env bash
# HLDD 016 Part 3 (CR-018-11): a push whose suite is red is blocked here, so a red
# HEAD cannot reach a pushed branch unnoticed. Opt in with `make hooks`; nothing
# installs this on its own. Skip one push with `git push --no-verify`.
# It runs lint and the pytest suite only, never the operator lanes (make tp,
# tp-full, the rr-* gates), which take over the display.
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"
echo "pre-push: make lint" >&2
make lint >&2
echo "pre-push: make test (skip this push with: git push --no-verify)" >&2
make test >&2
